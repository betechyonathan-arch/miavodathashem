# Copia este archivo como .env.local y rellena los dos valores de tu proyecto de Supabase
# (Supabase → Project Settings → API). Sin ellos la app funciona en modo de prueba local.
#
# La clave "anon public" es pública por diseño. NUNCA pongas aquí la "service_role".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
